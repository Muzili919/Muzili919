# 复制成 .env 后填写。.env 已在 .gitignore 里，不会被提交。

# ---- LLM（默认 DeepSeek，OpenAI 兼容接口）----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ---- 告警（至少配一个，否则失败你收不到通知）----
# Server酱 Turbo：https://sct.ftqq.com  微信收推送最省事
SERVERCHAN_SENDKEY=
# 钉钉群机器人 Webhook
DINGTALK_WEBHOOK=
# 钉钉加签密钥（机器人安全设置选"加签"时必填）
DINGTALK_SECRET=

# 邮件：唯一不用注册新服务的渠道，手上有 SMTP 授权码就能用。
# QQ 邮箱的授权码在「设置 → 账号 → POP3/SMTP」里生成，不是登录密码。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
